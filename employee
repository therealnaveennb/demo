def get_employees(request):
    user_email = request.employee
    user = Employee.objects.get(email__iexact=user_email)

    if user.role.access_level in [Role.AccessLevel.SUPER_ADMIN]:
        employees = Employee.objects.all()
        logger.info(f"{user.email} is SUPER_ADMIN. Fetching all employees.")
    else:
        employees = Employee.objects.filter(Q(manager=user) | Q(L2_manager=user))
        logger.info(f"{user.email} is not SUPER_ADMIN. Fetching employees managed by or reporting to them.")

    if not employees.exists():
        logger.info("No employees found for the given criteria.")
        return JsonResponse([], safe=False, status=status.HTTP_200_OK)

    # Check if pagination is requested
    is_paginated = 'page' in request.GET
    if is_paginated:
        paginator = CustomPagination()
        result_page = paginator.paginate_queryset(employees, request)
        logger.info(f"Paginated response requested. Page: {request.GET.get('page')}, Page size: {request.GET.get('page_size')}")
    else:
        result_page = employees
        logger.info("Non-paginated response requested. Returning all matching employees.")

    response_data = []
    for employee in result_page:
        employee_data = EmployeeSerializer(employee).data
        service_list = [pm.service.name for pm in PermissionMapper.objects.filter(employee=employee)]
        employee_data["total_expenses"] = get_total_expense(service_list)
        employee_data['total_services'] = len(service_list)
        employee_data['role'] = employee.role.name
        response_data.append(employee_data)

    logger.info(f"Retrieved {len(response_data)} employee records for response.")

    if is_paginated:
        return paginator.get_paginated_response(response_data)
    else:
        return JsonResponse(response_data, safe=False, status=status.HTTP_200_OK)
